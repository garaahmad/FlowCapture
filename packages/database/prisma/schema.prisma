generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
  DELETION_PENDING
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique @db.VarChar(100)
  name      String   @db.VarChar(120)
  planCode  String   @default("free") @map("plan_code") @db.VarChar(40)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user      User?
  auditLogs AuditLog[]

  @@map("workspaces")
}

model User {
  id                     String    @id @default(uuid()) @db.Uuid
  workspaceId            String    @unique @map("workspace_id") @db.Uuid
  email                  String    @unique @db.VarChar(320)
  passwordHash           String?   @map("password_hash") @db.VarChar(255)
  displayName            String    @map("display_name") @db.VarChar(120)
  preferredLanguage      String    @default("en") @map("preferred_language") @db.VarChar(10)
  timezone               String    @default("UTC") @db.VarChar(100)
  usageCategory          String?   @map("usage_category") @db.VarChar(30)
  dateFormat             String    @default("system") @map("date_format") @db.VarChar(20)
  status                 UserStatus @default(ACTIVE)
  emailVerifiedAt        DateTime? @map("email_verified_at") @db.Timestamptz(6)
  onboardingCompletedAt  DateTime? @map("onboarding_completed_at") @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessions  Session[]
  authTokens AuthToken[]
  auditLogs AuditLog[]
  conversations Conversation[]
  planApprovals PlanApproval[]

  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@map("users")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  userId     String    @map("user_id") @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  userAgent  String?   @map("user_agent") @db.VarChar(512)
  ipHash     String?   @map("ip_hash") @db.Char(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([workspaceId, expiresAt])
  @@map("sessions")
}

model AuthToken {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  purpose   AuthTokenPurpose
  tokenHash String           @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime?       @map("consumed_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, consumedAt, expiresAt])
  @@map("auth_tokens")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  workspaceId  String?  @map("workspace_id") @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  action       String   @db.VarChar(100)
  targetType   String?  @map("target_type") @db.VarChar(80)
  targetId     String?  @map("target_id") @db.Uuid
  metadata     Json?    @db.JsonB
  requestId    String?  @map("request_id") @db.VarChar(100)
  ipHash       String?  @map("ip_hash") @db.Char(64)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?      @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

enum ConversationStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum MessageKind {
  TEXT
  CLARIFICATION
  PLAN
  ERROR
}

enum PlanStatus {
  DRAFT
  NEEDS_CLARIFICATION
  APPROVED
  CHANGES_REQUESTED
}

enum Feasibility {
  SUPPORTED
  PARTIALLY_SUPPORTED
  UNSUPPORTED
}

model Conversation {
  id           String            @id @default(uuid()) @db.Uuid
  workspaceId  String            @map("workspace_id") @db.Uuid
  userId       String            @map("user_id") @db.Uuid
  title        String            @db.VarChar(200)
  status       ConversationStatus @default(DRAFT)
  draftState   Json?             @map("draft_state") @db.JsonB
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt   DateTime?         @map("archived_at") @db.Timestamptz(6)

  user         User              @relation(fields: [userId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  messages     Message[]
  plans        AutomationPlan[]

  @@unique([id, workspaceId])
  @@index([workspaceId, updatedAt])
  @@map("conversations")
}

model Message {
  id              String      @id @default(uuid()) @db.Uuid
  conversationId  String      @map("conversation_id") @db.Uuid
  workspaceId     String      @map("workspace_id") @db.Uuid
  role            MessageRole
  kind            MessageKind @default(TEXT)
  content         String      @db.Text
  payload         Json?       @db.JsonB
  planId          String?     @map("plan_id") @db.Uuid
  clientMessageId String?     @map("client_message_id") @db.VarChar(100)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([conversationId, clientMessageId])
  @@index([conversationId, createdAt])
  @@index([workspaceId, createdAt])
  @@map("messages")
}

model AutomationPlan {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  workspaceId    String       @map("workspace_id") @db.Uuid
  version        Int
  status         PlanStatus   @default(DRAFT)
  definition     Json         @db.JsonB
  contentHash    String       @map("content_hash") @db.Char(64)
  feasibility    Feasibility
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation   Conversation @relation(fields: [conversationId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  approvals      PlanApproval[]

  @@unique([conversationId, version])
  @@unique([id, workspaceId])
  @@index([workspaceId, createdAt])
  @@map("automation_plans")
}

model PlanApproval {
  id               String   @id @default(uuid()) @db.Uuid
  planId           String   @unique @map("plan_id") @db.Uuid
  workspaceId      String   @map("workspace_id") @db.Uuid
  approvedByUserId String   @map("approved_by_user_id") @db.Uuid
  planHash         String   @map("plan_hash") @db.Char(64)
  approvedAt       DateTime @default(now()) @map("approved_at") @db.Timestamptz(6)

  plan             AutomationPlan @relation(fields: [planId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  approvedBy       User           @relation(fields: [approvedByUserId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@index([workspaceId, approvedAt])
  @@map("plan_approvals")
}
