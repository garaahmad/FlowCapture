# Development placeholders only. Replace all values for a deployed environment.
POSTGRES_DB=flowcapture
POSTGRES_USER=flowcapture
POSTGRES_PASSWORD=development-only-change-me
DATABASE_URL=postgresql://flowcapture:development-only-change-me@localhost:5432/flowcapture?schema=public
REDIS_URL=redis://localhost:6379

NODE_ENV=development
PORT=3001
APP_BASE_URL=http://localhost:3000
WEB_ORIGINS=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:3001
COOKIE_SECURE=false
TRUST_PROXY=false
ALLOW_PREVIEW_ORIGINS=true
SWAGGER_ENABLED=true
SESSION_TTL_DAYS=30

# Optional transactional email. Never commit real SMTP credentials.
SMTP_URL=
MAIL_FROM=

# AI planning: disabled, deterministic (development only), openai, gemini, or groq.
# A remote fallback is optional and must differ from the remote primary provider.
PLANNER_MODE=deterministic
PLANNER_FALLBACK_MODE=disabled
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=1
