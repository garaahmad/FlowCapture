# Development placeholders only. Replace all values for a deployed environment.
POSTGRES_DB=flowcapture
POSTGRES_USER=flowcapture
POSTGRES_PASSWORD=development-only-change-me
DATABASE_URL=postgresql://flowcapture:development-only-change-me@localhost:5432/flowcapture?schema=public
REDIS_URL=redis://localhost:6379

NODE_ENV=development
PORT=3001
APP_BASE_URL=http://localhost:3000
WEB_ORIGINS=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:3001
COOKIE_SECURE=false
TRUST_PROXY=false
ALLOW_PREVIEW_ORIGINS=true
SWAGGER_ENABLED=true
SESSION_TTL_DAYS=30

# Optional transactional email. Never commit real SMTP credentials.
SMTP_URL=
MAIL_FROM=

# Development-only grounded fallback. Use openai with real credentials, or disabled, in production.
PLANNER_MODE=deterministic
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=1
